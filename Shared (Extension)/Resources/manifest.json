{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Digital Habits: Focus",
  "description": "Hide distractions on any site (YouTube, Instagram, LinkedIn, and more).",
  "version": "6.9.2",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "css": [
        "style.css"
      ],
      "js": [
        "shared_data.js",
        "selectors.js",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/popup-16.png",
      "19": "images/popup-19.png",
      "32": "images/popup-32.png",
      "38": "images/popup-38.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "nativeMessaging"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/calm.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mindshield@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  }
}
